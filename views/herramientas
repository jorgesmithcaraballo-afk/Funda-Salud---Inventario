import customtkinter as ctk

class HerramientasView(ctk.CTkFrame):
    def __init__(self, master, controlador):
        super().__init__(master)
        self.controlador = controlador
        self.configure(fg_color="white")

        ctk.CTkLabel(self, text="Vista de Herramientas", font=ctk.CTkFont(size=28, weight="bold")).pack(pady=20)

        # 🔐 Entrada de contraseña para acciones críticas
        self.pass_entry = ctk.CTkEntry(self, placeholder_text="Contraseña de administrador", show="*", width=300)
        self.pass_entry.pack(pady=10)

        # 👥 Botones de gestión
        ctk.CTkButton(self, text="Agregar usuario", command=self.abrir_formulario_agregar).pack(pady=5)
        ctk.CTkButton(self, text="Actualizar usuario", command=self.abrir_formulario_actualizar).pack(pady=5)
        ctk.CTkButton(self, text="Eliminar usuario", command=self.abrir_formulario_eliminar).pack(pady=5)

        # 💣 Botón para borrar toda la BD
        ctk.CTkButton(self, text="🧨 Borrar toda la base de datos", fg_color="red", hover_color="#aa0000",
            command=self.confirmar_borrado_total).pack(pady=20)

    def validar_contrasena(self):
        contrasena = self.pass_entry.get()
        # Aquí deberías validar contra la tabla de usuarios o una clave maestra
        return contrasena == "clave_segura"  # ← reemplazá con tu lógica real

    def confirmar_borrado_total(self):
        if not self.validar_contrasena():
            messagebox.showerror("Error", "Contraseña incorrecta.")
            return

