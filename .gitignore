__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pdb

# Archivos compilados y binarios
*.so
*.dll
*.exe
*.exe.manifest
*.spec
*.bin

# ----------------------------------------
# Entornos virtuales
# ----------------------------------------
.venv/
venv/
env/
ENV/
env.bak/

# ----------------------------------------
